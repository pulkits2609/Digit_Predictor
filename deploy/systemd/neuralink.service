[Unit]
Description=NeuralInk FastAPI inference service
After=network.target

[Service]
Type=simple
User=neuralink
Group=neuralink
WorkingDirectory=/opt/neuralink/backend
EnvironmentFile=/etc/neuralink/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TF_NUM_INTRAOP_THREADS=2
Environment=TF_NUM_INTEROP_THREADS=1
Environment=KERAS_HOME=/tmp/keras
Environment=MPLCONFIGDIR=/tmp/matplotlib
ExecStart=/opt/neuralink/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
