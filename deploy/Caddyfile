{
	email {$TLS_EMAIL}
	admin off
}

{$API_DOMAIN} {
	request_body {
		max_size {$MAX_REQUEST_BODY:6MB}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy {$API_UPSTREAM:127.0.0.1:8000} {
		# Uvicorn does not trust arbitrary forwarded client addresses.
		# X-Real-IP is informational; the app uses the socket peer by default.
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
